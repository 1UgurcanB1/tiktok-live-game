{
  "name": "@tiktok/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint . --ext .ts --cache",
    "lint:fix": "eslint . --ext .ts --cache --fix && prettier --write ."
  },
  "dependencies": {
    "@tiktok/constants": "workspace:*",
    "@tiktok/types": "workspace:*",
    "@tiktok/utils": "workspace:*",
    "cors": "2.8.5",
    "dotenv": "17.2.2",
    "express": "5.1.0",
    "mongoose": "8.18.2",
    "tiktok-live-connector": "2.0.7-beta1",
    "ws": "8.18.3",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/node": "24.5.2",
    "@types/ws": "8.18.1"
  }
}
