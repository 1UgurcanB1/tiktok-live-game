NODE_ENV=development
PORT=3001
WS_PATH=/ws

# StackBlitz/Bolt/WebContainer development: no TCP database required.
DATABASE_MODE=memory
# Production/cloud: set DATABASE_MODE=mongo and use a MongoDB Atlas URI.
# DATABASE_URL=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/tiktok_live?retryWrites=true&w=majority

TIKTOK_USERNAME=telechubbiies
TIKTOK_MODE=sim
